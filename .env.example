# External API Configurations
OPENWEATHER_API_KEY=openweather_api_key

# OpenWeather API Endpoints (optional - defaults provided)
# GEOCODING_API_URL=http://api.openweathermap.org/geo/1.0/direct
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# API Request Configuration (optional - defaults provided)
# WEATHER_UNITS=metric          # Options: metric, imperial, standard
# WEATHER_LANG=pt_br            # Language code for weather descriptions
# API_TIMEOUT=10                # Request timeout in seconds
# GEOCODING_LIMIT=1             # Number of geocoding results to return

# Database Configurations
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gntech_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Conection URL
DATABASE_URL=postgresql://postgres:password@db:5432/gntech_db